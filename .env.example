# Copy into .env for local development only; never commit .env or secrets.
# The same server-side key powers chatbot and receipt extraction.
# OpenAI (default): keep AI_BASE_URL empty and OPENAI_MODEL=gpt-5-mini.
# MiraiAPI: AI_BASE_URL=https://api.miraiapi.com/v1, OPENAI_MODEL=claude-opus-4.8.
# Configure secrets in Vercel; never store an API key in Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_BASE_URL=

# Ethereum Sepolia testnet (chain ID 11155111).
SEPOLIA_RPC_URL=
AUREVA_CONTRACT_ADDRESS=
# Optional: server-side testnet signer. Leave empty when using MetaMask signing.
BLOCKCHAIN_PRIVATE_KEY=

# Choose ONE persistent data store. Prefer PostgreSQL for hosted deployments.
DATABASE_URL=
AUREVA_DB=
# On Postgres, choose aureva (production) or aureva_preview (protected preview).
AUREVA_DB_SCHEMA=aureva

# Replace with the exact HTTPS origin in hosted environments.
AUREVA_ORIGIN=http://127.0.0.1:8001
AUREVA_SECURE_COOKIE=0

# ONLY on isolated, protected Vercel Preview with aureva_preview DB.
# Leave disabled on production.
AUREVA_DEMO_SWITCH=0
